; Protocol 1.1 additions. Combine with ../v1/v1.abnf; existing v1 rules are unchanged.
; The `commands` feature must be agreed before r-unregister is sent.
feature      =/ "commands"
request      =/ id SP r-unregister
r-unregister = "unregister" SP name

; Workspace invalidations require agreed workspace_watch and project read/write permission.
feature      =/ "workspace_watch"
request      =/ id SP r-watch-workspace / id SP r-unwatch-workspace
r-watch-workspace = "watch-workspace"
r-unwatch-workspace = "unwatch-workspace" SP id
event        =/ "0" SP "watch" SP id SP ( "changed" / "rescan" )
; Handles are runtime-owned, positive and at most 2147483647; events are coalesced.

; save-actions must be agreed; save-apply has a workspace-edit body of LEN bytes.
feature      =/ "save-actions"
host-request =/ id SP "save-actions" SP doc SP version SP source-kind
request      =/ id SP r-save-apply
r-save-apply = "save-apply" SP id SP doc SP version SP len
source-kind  = "source" *( "." 1*( ALPHA / DIGIT / "_" / "-" ) )
              ; at most 128 bytes; DOC is positive; VERSION is nonnegative

; Prepared native snippet fields. Agree snippets before the explicit request.
feature      =/ "snippets"
request      =/ id SP r-snippet
r-snippet    = "snippet" SP doc SP version SP range SP len
c-extra      =/ "field" SP num SP num SP num SP num SP "0" LF
              ; GROUP START END PARENT, then zero body length
snippet-head = "0 0 0 0 snippet 0 " len SP "0" SP len LF
              ; INSERT and EXTRA lengths, followed by exactly those bytes
c-extra      =/ "choice" SP num SP num SP len LF
              ; positive GROUP, COUNT 1..256, LEN bytes of option records
choice-option = len LF
              ; followed by exactly LEN UTF-8 bytes, at most 1 MiB each

; Read-only insertion context. Requires agreed snippets and documents=read.
request      =/ id SP r-snippet-context
r-snippet-context = "snippet-context" SP doc SP version SP range
snippet-context-head = "context 1" SP num SP num SP num SP num SP num
                       SP len SP len SP len SP len SP len SP len LF
              ; LINE COL TABWIDTH SPACES CRLF, then six byte lengths:
              ; selected text, current line, path, workspace, indentation, line comment.
              ; Exactly those six UTF-8 strings follow; body including header <=4 MiB.

; Initial differences between ordinary mirrors require BOTH negotiated features.
feature      =/ "snippet-variants"
c-extra      =/ "variant" SP num SP "0" LF
              ; one-based nonprimary FIELD 1..512, initially unequal to primary

; Compiled transforms require BOTH snippets and snippet-transforms.
feature      =/ "snippet-transforms"
c-extra      =/ "transforms" SP "0" SP len LF
              ; followed by LEN canonical RFC 4648 standard padded Base64 bytes;
              ; one SNTX v1 payload, at most one record, see v1.1.md for binary layouts.

; Notebooks (v1.1.md, "Feature: notebooks"). rhun's requests nb-open and nb-save are answered
; "ok" SP id SP len LF + body; their answers may carry up to 64 MiB.
feature      =/ "notebooks"
host-request =/ id SP "nb-open" SP id SP len
              ; PATH_LEN SP DATA_LEN LF, then PATH and DATA
host-request =/ id SP "nb-save" SP id SP len
              ; PATH_LEN LF, PATH, then a notebook body
event        =/ "0" SP "nb-run" SP id SP id SP id SP nb-lang SP len
              ; NB CELL RUN LANG, then the cell's source
event        =/ "0" SP ( "nb-interrupt" / "nb-restart" / "nb-kernel" / "nb-closed" ) SP id
request      =/ id SP "nb-state" SP id SP id SP id SP nb-state SP ( num / "-" )
request      =/ id SP "nb-output" SP id SP id SP id SP nb-op SP ( num / nb-token / "-" ) SP len
              ; an output body; clear and clear-wait carry none (LEN 0)
request      =/ id SP "nb-stream" SP id SP id SP id SP ( "stdout" / "stderr" ) SP len
request      =/ id SP "nb-kernel-label" SP id SP nb-kstate SP len
request      =/ id SP "nb-exec" SP id SP len
              ; NB, then a command body as test-exec's; answered "ok" SP id SP num (EXEC)
request      =/ id SP "nb-exec-signal" SP num SP ( "interrupt" / "terminate" / "kill" )
event        =/ "0" SP "nb-exec-exit" SP num SP ( num / "killed" )
nb-state     = "queued" / "running" / "done" / "failed" / "cancelled"
nb-kstate    = "idle" / "busy" / "starting" / "dead" / "none"
nb-op        = "append" / "replace" / "clear" / "clear-wait"
nb-lang      = 1*VCHAR                       ; a grammar name, spaces as "_", or "-"
nb-token     = 1*64( %x61-7A / DIGIT / "_" / "." / "+" / "/" / "-" )
nb-body      = num SP len LF nb-meta *nb-cell
              ; N cells, the notebook's metadata
nb-cell      = ( "code" / "markup" ) SP nb-lang SP ( num / "-" ) SP len SP len SP num LF
              ; SOURCE_LEN META_LEN NOUT, then SOURCE, META and NOUT nb-output-body
nb-output-body = ( "stdout" / "stderr" / "result" / "display" / "error" ) SP ( nb-token / "-" )
                 SP len SP num LF
              ; KEEP_LEN NITEM, then KEEP and NITEM items
nb-item      = nb-token SP num SP num SP len LF
              ; TYPE W H LEN, then LEN bytes
nb-meta      = *OCTET                        ; META_LEN opaque bytes

; Source control. git-data requires [needs] git = read; replies are length-framed (v1.1.md).
feature      =/ "git-data"
request      =/ id SP r-git
r-git        = "git-repo" / "git-status" / "git-blame" SP doc
             / "git-log" SP num SP num SP num SP len      ; MAX 1..1000, L1 L2 (0 0: the whole file), path body
             / "git-show" SP rev SP len                   ; path body
             / "git-diff-open" SP rev SP ( rev / "-" ) SP len   ; path body; "-" the work tree
rev          = ( ALPHA / DIGIT / "_" / "." / "/" / "~" / "^" / "@" / "{" / "}" / "+" ) *199( ALPHA / DIGIT / "_" / "." / "/" / "~" / "^" / "@" / "{" / "}" / "+" / "-" )
event        =/ "0" SP "git" SP "changed"
git-repo-head = len SP len SP len SP ( "branch" / "detached" / "unborn" ) SP num SP num SP ( "clean" / "dirty" / "merging" / "rebasing" ) LF
git-status-entry = 2( %x21-7E ) SP len LF                  ; XY ("." an unchanged side), then the path's bytes
blame-head   = num SP num LF                               ; NC NR
blame-commit = sha SP num SP len SP len SP len LF          ; then AUTHOR MAIL SUMMARY bytes
blame-run    = sha SP num SP num SP num LF                 ; L1 L2 ORIG_L1
log-entry    = sha SP ( sha *( "," sha ) / "-" ) SP num SP len SP len LF   ; then AUTHOR SUBJECT bytes
sha          = 40HEXDIG / 64HEXDIG

; commit-message: rhun asks; body BRANCH_LEN DIFF_LEN LF <BRANCH><DIFF>; the answer is the message
feature      =/ "commit-message"
host-request =/ id SP "commit-message" SP len

; quickdiff: rhun asks for a file's base text (ok ID LEN + the bytes, ok ID 0 for none)
feature      =/ "quickdiff"
host-request =/ id SP "quickdiff" SP doc SP version
request      =/ id SP "quickdiff-refresh" SP len               ; body: an absolute path or "-"
