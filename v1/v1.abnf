; rhun extension protocol, version 1: the grammar of what travels on the pipes (RFC 5234 ABNF).
; v1.md says what each message means; this says exactly what it looks like. Bodies are raw
; bytes that follow a message's LF and are not part of the grammar of lines.

stream        = *message
message       = ( request / reply / event ) LF [ body ]
              ; body is present iff the message's last field is a LEN of a body-bearing message
              ; and is exactly LEN bytes

LF            = %x0A
SP            = %x20
field         = 1*( %x21-7E / %x80-FF )          ; no space, no LF, no CR
rest          = field *( SP field )               ; a last field that may contain spaces
num           = 1*DIGIT
id            = %x31-39 *9DIGIT                   ; 1 .. 2147483647 (the receiver checks the bound)
version       = num
doc           = num
len           = num
line          = num                               ; 1-based
col           = num                               ; 1-based byte column within the line
pos           = line SP col
range         = pos SP pos                        ; half-open: from the first to before the second

; ---- the extension's first line
hello         = "hello" SP "1" *( SP field )      ; further fields: capabilities (none in v1)

; ---- requests from the extension (a body follows replace, insert, toast, status, diagnostics,
;      hover, choose, ask and term)
request       = id SP ( r-text / r-range / r-replace / r-insert / r-select / r-toast / r-status
                      / r-open / r-cancel / r-register / r-option / r-diagnostics / r-hover
                      / r-choose / r-ask / r-term / r-cmd )
r-text        = "text" SP doc
r-range       = "range" SP doc SP range
r-replace     = "replace" SP doc SP version SP range SP len
r-insert      = "insert" SP doc SP version SP len
r-select      = "select" SP doc SP range
r-toast       = "toast" SP len
r-status      = "status" SP len
r-open        = "open" SP line SP col SP rest     ; line and col 0 keep the file's cursor
r-cancel      = "cancel" SP id
r-register    = "register" SP name SP field SP rest   ; NAME KEY TITLE (one combination, or "-")
name          = 1*40( %x61-7A / DIGIT / "_" )          ; a command name: [a-z0-9_]
r-option      = "option" SP doc SP opt-key SP opt-value
opt-key       = "tab_width" / "insert_spaces" / "trim_trailing_whitespace" / "final_newline"
opt-value     = "yes" / "no" / num / "-"                ; num for tab_width (1..16); "-" removes
r-choose      = "choose" SP len                        ; body: the prompt line, then one item per line
r-ask         = "ask" SP len                           ; body: the prompt
r-term        = "term" SP len                          ; body: one command line, no control characters
r-cmd         = "cmd" SP field                         ; a command name from section 8a
r-diagnostics = "diagnostics" SP doc SP version SP num SP len   ; num: the lines of the body
r-hover       = "hover" SP doc SP pos SP len           ; the text to show at the position

; ---- the body of diagnostics: num lines (section 6b)
diag-line     = range SP severity SP rest LF           ; rest: the message, no LF in it
severity      = "error" / "warning" / "info" / "hint"

; ---- the body of the edits event: records (section 6a); the bytes of each follow its LF
edit-record   = num SP num SP num LF                  ; START DEL INS, byte offsets and counts

; ---- replies from rhun (a body follows the ok of text, range and ask: its LEN is the last field)
reply         = ok / error
ok            = "ok" SP id *( SP field )               ; choose: ok ID N; ask: ok ID LEN + body
error         = "error" SP id SP code [ SP rest ]
code          = "syntax" / "unknown" / "needs" / "nodoc" / "nofile" / "readonly" / "stale"
              / "badpos" / "toobig" / "busy" / "cancelled" / "refused"

; ---- events from rhun
event         = "0" SP ( e-ready / e-opened / e-active / e-saved / e-changed / e-cursor
                       / e-selection / e-closed / e-project / e-run / e-bye
                       / e-edits / e-resync / e-hover )
e-ready       = "ready" SP rest                   ; the project folder, or "-"
e-opened      = "opened" SP doc SP version SP lang SP rest   ; rest: the path, or "-"
lang          = "-" / field                       ; a grammar name with spaces as "_"
e-active      = "active" SP doc                   ; 0 when no document is active
e-saved       = "saved" SP doc SP version
e-changed     = "changed" SP doc SP version
e-cursor      = "cursor" SP doc SP pos
e-selection   = "selection" SP doc SP range       ; anchor, then cursor
e-closed      = "closed" SP doc
e-project     = "project" SP rest                 ; the new project folder, or "-"
e-run         = "run" SP field SP doc             ; NAME.command and the active document or 0
e-bye         = "bye"
e-edits       = "edits" SP doc SP version SP len     ; a body of edit-records follows
e-resync      = "resync" SP doc SP version           ; deltas were lost: fetch text
e-hover       = "hover" SP doc SP pos                ; the pointer rests there
